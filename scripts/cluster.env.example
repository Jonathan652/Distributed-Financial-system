# ================================================================
# CLUSTER ENV TEMPLATE (REPLACE VALUES ONLY)
# ================================================================
# 1) Copy to scripts/cluster.env on each machine.
# 2) Replace ONLY values on the right side of =
# 3) Keep variable names unchanged.
#
# Quick role usage:
# - Coordinator machine   -> ./scripts/start_coordinator.sh
# - Regional node machine -> ./scripts/start_regional_node.sh
# - Gateway machine       -> ./scripts/start_gateway.sh
# ================================================================

# ---------------- COMMON ----------------
# Use 0.0.0.0 to listen on all network interfaces.
HOST=0.0.0.0

# ---------------- COORDINATOR ----------------
# For ./scripts/start_coordinator.sh
# NOTE: start_coordinator.sh uses PORT (not COORDINATOR_PORT).
PORT=8081
DB_PATH=/tmp/uganda-ledger.sqlite3
REGIONS=kampala,mbarara,gulu,jinja

# ---------------- REGIONAL NODE ----------------
# For ./scripts/start_regional_node.sh
# Set one region per machine: kampala | mbarara | gulu | jinja
REGION=REGION_NAME_HERE
REGIONAL_PORT=8082

# Single coordinator setup:
# Example: http://192.168.1.10:8081
COORDINATOR_URL=http://COORDINATOR_IP_HERE:8081

# Optional multi-coordinator sharding (comma-separated URLs)
# Leave empty for single coordinator mode.
# Example: http://192.168.1.10:9001,http://192.168.1.11:9002
COORDINATORS=

# ---------------- GATEWAY ----------------
# For ./scripts/start_gateway.sh
GATEWAY_PORT=8000

# Comma-separated regional node URLs.
# Example: http://192.168.1.20:8082,http://192.168.1.30:8082,http://192.168.1.40:8082,http://192.168.1.50:8082
REGIONAL_NODES=

# Comma-separated coordinator URLs.
# Single-coordinator example: http://192.168.1.10:8081
# Multi-coordinator example:  http://192.168.1.10:9001,http://192.168.1.11:9002
COORDINATOR_URLS=

# ================================================================
# READY-TO-PASTE VALUES BY MACHINE ROLE
# Copy one block below into scripts/cluster.env and replace IPs.
# ================================================================

# [A] COORDINATOR MACHINE (single coordinator)
# HOST=0.0.0.0
# PORT=8081
# DB_PATH=/tmp/uganda-ledger.sqlite3
# REGIONS=kampala,mbarara,gulu,jinja

# [B] REGIONAL MACHINE - KAMPALA
# HOST=0.0.0.0
# REGION=kampala
# REGIONAL_PORT=8082
# COORDINATOR_URL=http://COORDINATOR_IP_HERE:8081
# COORDINATORS=

# [C] REGIONAL MACHINE - MBARARA
# HOST=0.0.0.0
# REGION=mbarara
# REGIONAL_PORT=8082
# COORDINATOR_URL=http://COORDINATOR_IP_HERE:8081
# COORDINATORS=

# [D] REGIONAL MACHINE - GULU
# HOST=0.0.0.0
# REGION=gulu
# REGIONAL_PORT=8082
# COORDINATOR_URL=http://COORDINATOR_IP_HERE:8081
# COORDINATORS=

# [E] REGIONAL MACHINE - JINJA
# HOST=0.0.0.0
# REGION=jinja
# REGIONAL_PORT=8082
# COORDINATOR_URL=http://COORDINATOR_IP_HERE:8081
# COORDINATORS=

# [F] GATEWAY MACHINE (optional)
# HOST=0.0.0.0
# GATEWAY_PORT=8000
# REGIONAL_NODES=http://KAMPALA_NODE_IP_HERE:8082,http://MBARARA_NODE_IP_HERE:8082,http://GULU_NODE_IP_HERE:8082,http://JINJA_NODE_IP_HERE:8082
# COORDINATOR_URLS=http://COORDINATOR_IP_HERE:8081
